-- ===== BONUS / MALUS =====

-- Poisons
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='poisons'), q, v
FROM (SELECT -2 q,1 v UNION ALL SELECT -1,1 UNION ALL SELECT 0,0 UNION ALL SELECT 1,0 UNION ALL SELECT 2,-1 UNION ALL SELECT 3,-2);

-- Paralysie
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
