-- Acide
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='acide'), q, v
FROM (SELECT -2 q,-4 v UNION ALL SELECT -1,-5 UNION ALL SELECT 0,-7 UNION ALL SELECT 1,-10 UNION ALL SELECT 2,-14 UNION ALL SELECT 3,-20);

-- ===== Chute / Températures / Initiative / Vitesse / Dextérité =====

-- Chute (%)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='chute'), q, v
FROM (SELECT -2 q,-2 v UNION ALL SELECT -1,-3 UNION ALL SELECT 0,-4 UNION ALL SELECT 1,-5 UNION ALL SELECT 2,-7 UNION ALL SELECT 3,-10);

-- Chaleur (°C)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='chaleur'), q, v
FROM (SELECT -2 q,23 v UNION ALL SELECT -1,25 UNION ALL SELECT 0,27 UNION ALL SELECT 1,30 UNION ALL SELECT 2,30 UNION ALL SELECT 3,35);

-- Froid (°C)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='froid'), q, v
FROM (SELECT -2 q,15 v UNION ALL SELECT -1,12 UNION ALL SELECT 0,9 UNION ALL SELECT 1,7 UNION ALL SELECT 2,5 UNION ALL SELECT 3,0);

-- Initiative
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='initiative'), q, v
FROM (SELECT -2 q,0 v UNION ALL SELECT -1,0 UNION ALL SELECT 0,0 UNION ALL SELECT 1,0 UNION ALL SELECT 2,0 UNION ALL SELECT 3,0);

-- Vitesse (m)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='vitesse'), q, v
FROM (SELECT -2 q,0 v UNION ALL SELECT -1,0 UNION ALL SELECT 0,0 UNION ALL SELECT 1,0 UNION ALL SELECT 2,0 UNION ALL SELECT 3,0);

-- Dextérité
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='dexterite'), q, v
FROM (SELECT -2 q,0 v UNION ALL SELECT -1,0 UNION ALL SELECT 0,0 UNION ALL SELECT 1,0 UNION ALL SELECT 2,0 UNION ALL SELECT 3,0);

-- 4) Poids par qualité
INSERT OR REPLACE INTO MATERIAUX_POIDS (id_materiau, qualite, poids)
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       q, p
FROM (SELECT -2 q,1.0 p UNION ALL SELECT -1,2.0 UNION ALL SELECT 0,3.0 UNION ALL SELECT 1,4.0 UNION ALL SELECT 2,6.0 UNION ALL SELECT 3,8.0);

-- 5) Valeur par qualité
INSERT OR REPLACE INTO MATERIAUX_VALEUR (id_materiau, qualite, valeur)
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       q, v
FROM (SELECT -2 q,67 v UNION ALL SELECT -1,100 UNION ALL SELECT 0,150 UNION ALL SELECT 1,224 UNION ALL SELECT 2,336 UNION ALL SELECT 3,503);
