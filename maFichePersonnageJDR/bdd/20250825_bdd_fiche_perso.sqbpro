<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/Utilisateur/source/repos/maFichePersonnageJDR/maFichePersonnageJDR/bdd/20231109_bdd_fiche_perso.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4592"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,9:mainAPTITUDES"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1">-- 1) Matériau
INSERT OR IGNORE INTO MATERIAUX (nom_materiau, categorie, realisme, description)
VALUES ('Substance gélatineuse', 'Animal', 'fantastique',
        'Masse visqueuse quasi amorphe : énorme résistance aux éléments (feu, eau, céleste, terrestre), mais très vulnérable aux dégâts physiques. Très peu sensible aux états, mais réagit mal aux acides.');

-- 2) Coût &amp; rareté (base = valeur à Q0)
INSERT OR IGNORE INTO MATERIAUX_COUTS (id_materiau, base_valeur, rarete)
SELECT id_materiau, 150, 4
FROM MATERIAUX
WHERE nom_materiau='Substance gélatineuse';

-- 3) Effets dégâts

-- Tranchant
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='tranchant'), q, v
FROM (SELECT -2 q,-10 v UNION ALL SELECT -1,-15 UNION ALL SELECT 0,-22 UNION ALL SELECT 1,-33 UNION ALL SELECT 2,-50 UNION ALL SELECT 3,-75);

-- Contondant
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='contondant'), q, v
FROM (SELECT -2 q,-10 v UNION ALL SELECT -1,-15 UNION ALL SELECT 0,-22 UNION ALL SELECT 1,-33 UNION ALL SELECT 2,-50 UNION ALL SELECT 3,-75);

