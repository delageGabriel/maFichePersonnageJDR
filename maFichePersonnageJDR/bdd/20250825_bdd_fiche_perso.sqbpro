INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='aquatique'), q, v
FROM (SELECT -2 q,60 v UNION ALL SELECT -1,40 UNION ALL SELECT 0,27 UNION ALL SELECT 1,18 UNION ALL SELECT 2,12 UNION ALL SELECT 3,8);

