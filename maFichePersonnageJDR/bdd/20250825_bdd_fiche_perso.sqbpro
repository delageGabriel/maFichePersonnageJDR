INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Substance gélatineuse'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='perforant'), q, v
FROM (SELECT -2 q,-10 v UNION ALL SELECT -1,-15 UNION ALL SELECT 0,-22 UNION ALL SELECT 1,-33 UNION ALL SELECT 2,-50 UNION ALL SELECT 3,-75);

