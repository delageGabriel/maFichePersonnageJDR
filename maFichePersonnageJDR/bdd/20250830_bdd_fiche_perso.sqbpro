<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/Utilisateur/source/repos/maFichePersonnageJDR/maFichePersonnageJDR/bdd/20231109_bdd_fiche_perso.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4592"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,16:mainMATERIAUX_VALEUR"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="APTITUDES" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="82"/><column index="2" value="218"/><column index="3" value="284"/><column index="4" value="300"/><column index="6" value="114"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="MATERIAUX_POIDS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="85"/><column index="2" value="52"/><column index="3" value="42"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="MATERIAUX_VALEUR" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="85"/><column index="2" value="52"/><column index="3" value="53"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="REF_EFFETS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="59"/><column index="2" value="78"/><column index="3" value="143"/><column index="4" value="70"/><column index="5" value="41"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT m.nom_materiau,
r.code,
me.valeur,
me.qualite
FROM MATERIAUX AS m
JOIN MATERIAUX_EFFETS AS me
ON me.id_materiau = m.id_materiau
JOIN REF_EFFETS AS r
ON me.id_effet = r.id_effet
WHERE me.qualite = 3
AND m.nom_materiau = 'Tissu';

SELECT mv.valeur FROM MATERIAUX_VALEUR AS mv
JOIN MATERIAUX AS m
ON m.id_materiau = mv.id_materiau
WHERE mv.qualite = 2
AND m.nom_materiau = 'Tissu';

SELECT mp.poids FROM MATERIAUX_POIDS AS mp
JOIN MATERIAUX AS m
ON m.id_materiau = mp.id_materiau
WHERE mp.qualite = 2
AND m.nom_materiau = 'Tissu';</sql><sql name="SQL 2">SELECT mv.valeur FROM MATERIAUX_VALEUR AS mv
JOIN MATERIAUX AS m
ON m.id_materiau = mv.id_materiau
WHERE mv.qualite = @qualite
AND m.nom_materiau = @nomMateriau;</sql><current_tab id="0"/></tab_sql></sqlb_project>
