<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/Utilisateur/source/repos/maFichePersonnageJDR/maFichePersonnageJDR/bdd/20231109_bdd_fiche_perso.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5356"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,9:mainAPTITUDES"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="APTITUDES" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort><column index="2" mode="0"/></sort><column_widths><column index="1" value="40"/><column index="2" value="305"/><column index="3" value="88"/><column index="4" value="79"/><column index="5" value="165"/><column index="6" value="216"/><column index="7" value="124"/><column index="8" value="137"/><column index="9" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="ARMURES" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="74"/><column index="2" value="93"/><column index="3" value="150"/><column index="4" value="97"/><column index="5" value="104"/><column index="6" value="199"/><column index="7" value="102"/><column index="8" value="300"/><column index="9" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="ATTRIBUTS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="78"/><column index="2" value="172"/><column index="3" value="300"/><column index="4" value="150"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="JEUX_SORTS_APTITUDES" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="40"/><column index="2" value="167"/><column index="3" value="51"/><column index="4" value="232"/><column index="5" value="40"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="NEW_ARMURES" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="74"/><column index="2" value="300"/><column index="3" value="94"/><column index="4" value="254"/><column index="5" value="300"/><column index="6" value="109"/><column index="7" value="118"/><column index="8" value="128"/><column index="9" value="116"/><column index="10" value="88"/><column index="11" value="118"/><column index="13" value="114"/><column index="14" value="83"/><column index="15" value="87"/><column index="16" value="108"/><column index="17" value="97"/><column index="18" value="104"/><column index="19" value="115"/><column index="20" value="111"/><column index="21" value="102"/><column index="22" value="85"/><column index="23" value="103"/><column index="24" value="95"/><column index="25" value="140"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="OBJETS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="68"/><column index="2" value="126"/><column index="3" value="84"/><column index="4" value="91"/><column index="5" value="80"/><column index="6" value="137"/><column index="7" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="SORTS" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort><column index="2" mode="0"/></sort><column_widths><column index="1" value="40"/><column index="2" value="232"/><column index="3" value="64"/><column index="4" value="79"/><column index="5" value="157"/><column index="6" value="208"/><column index="7" value="300"/><column index="8" value="111"/><column index="9" value="129"/><column index="10" value="161"/><column index="11" value="246"/><column index="12" value="258"/><column index="13" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Adaptation au climat',
'Nature',
'Mixte',
'Personnelle',
'1 h',
'Aucune',
'Aucun.',
'1 action',
'Contact, Vocal',
'Aucun',
'“Que ce climat soit mien !”',
'La créature touche une cible avec ses mains, et cette dernière devient capable de
survivre dans le climat dans lequel ils se trouvent.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Animation d’objets',
'Neutre',
'Mixte',
'45 m (30 cases)',
'10 mn',
'Aucune',
'Aucun.',
'1 action',
'Vocal, Contact, Ingrédients',
'- Objet de taille Très petite à Moyenne',
'“Prends vie !”',
'La créature enchante un objet de taille Très petite à Moyenne afin de lui donner
une animation magique.
L’objet s’anime et agit de manière simple et cohérente avec sa nature :
- un pantin peut marcher, gesticuler ou danser ;
- des chaussures peuvent se déplacer seules et entraîner leur porteur ;
- une corde peut se tortiller ou s’enrouler ;
- un balai peut se déplacer et balayer ;
- un sac peut ramper ou tenter de s’enfuir.
L’objet ne parle pas et ne réfléchit pas, mais se contente d’exécuter des actions simples tant
que l’effet dure.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Animation imparfaite',
'Corrompu',
'Mixte',
'15 m (10 cases)',
'Cible(s) intacte(s) ou dans la
portée.',
'- Niveau 1 : 3 morts
- Niveau 5 : 5 morts
- Niveau 10 : 8 morts
- Niveau 15 : 11 morts
- Niveau 20 : 13 morts',
'Aucun.',
'1 tour',
'Vocal, Ingrédients',
'Cadavre de taille Très petite
ou Petite',
'“Relève toi !”',
'La créature insuffle momentanément la vie dans un cadavre et peut lui donner des
ordres. Le mort en question ne peut utiliser ni aptitudes, ni sortilèges même s’il en
connaissait de son vivant.
Enfin, ses points de vie sont réduits de moitié, et les dégâts de ses attaques aussi.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Animation des morts',
'Corrompu',
'Mixte',
'18 m (12 cases)',
'Cible(s) intacte(s) ou dans la
portée.',
'- Niveau 1 : 2 morts
- Niveau 5 : 3 morts
- Niveau 10 : 5 morts
- Niveau 15 : 7 morts
- Niveau 20 : 8 morts',
'Aucun.',
'1 tour',
'Vocal, Ingrédients',
'Cadavre de taille Moyenne,
Petite ou Très petite.',
'“Relève toi !”',
'La créature insuffle momentanément la vie dans un cadavre et peut lui donner des
ordres. Le mort en question n’est pas doté d’intelligence, mais possède quand même un
instinct de survie proche de celui d’un animal. Il ne peut pas utiliser de sort ou d’aptitudes,
mais il a tous ses points de vie, et sait parfaitement manier une arme.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Apparition miraculeuse',
'Divin',
'Hors combat',
'Personnelle',
'1 action',
'1/j',
'Aucun.',
'1 action',
'Vocal, Ingrédients',
'- 1 bougie',
'“Esprit, viens moi en aide !”',
'La créature s’agenouille au sol, allume une bougie et fait une prière. Un esprit
bienfaisant apparaît devant elle pour répondre à une de ses questions de façon énigmatique,
pour lui indiquer la bonne voie à suivre pour un objectif, pour la guider.
Une fois la demande répondue, la bougie est entièrement consumée, et l’esprit disparaît.
NB : La demande ne doit aucunement porter préjudice à qui que ce soit, sinon l’esprit ne
répondra pas'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Appel d’éclair',
'Céleste',
'Mixte',
'Cible',
'1d4 tour(s)',
'Aucune',
'Aucun.',
'1 action',
'Contact, Vocal',
'Aucun',
'“Grondez, ô cieux !”',
'La créature touche avec ses mains ou un autre objet une cible, un éclair jaillit du
ciel et vient s’abattre sur la cible, provoquant 1d6+3 dégâts Céleste et la paralysant pendant
un certain nombre de tours si elle est sensible à ce statut !
Ne marche qu’en extérieur.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Appel à la possession',
'Corrompu',
'Hors combat',
'Cible',
'Lever de la malédiction ou
exorcisme',
'1 personne',
'Volonté',
'30 mn',
'Vocal, Ingrédients',
'- Effets personnels de la cible,
- Os du fantôme de la possession,
- Encens,
- Sang pour tracer un cercle
- La nuit',
'“Prend tout l’être de ce misérable !”',
'La créature va procéder à un rituel (attendre la nuit, puis tracer avec du sang un
cercle, placer au centre un récipient dans lequel doit brûler l’os du fantôme, l’effet
personnel de la cible et l’encens) qui va invoquer un mort spécifique qui prendra
possession d’une cible. La cible possédée sera en grande partie sous le joug du fantôme, et
si elle veut éviter de faire une action (comme tuer quelqu’un) elle devra faire un jet de
Volonté et partir très vite.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Arme enflammée',
'Igné',
'Mixte',
'Arme',
'1 h',
'Aucune',
'Aucun.',
'Instantané',
'Contact',
'Aucun',
'Aucune',
'La créature appose un enchantement de feu sur son arme, cette dernière peut
donc faire 1d[Dégâts de l’arme] de dégâts Ignés.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Arrêt aérien',
'Céleste',
'Mixte',
'27 m (18 cases)',
'1 action',
'Aucune',
'Aucun.',
'Instantané',
'Vocal',
'Aucun',
'“Arrêtez-nous !”',
'La créature fait appel aux vents pour s’arrêter net dans une chute, elle et tout ce
qui se trouve dans le rayon d’action du sort.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Augmentation des défenses corporelles',
'Divin',
'Mixte',
'Personnelle',
'Disparaît après usage',
'Aucune',
'Aucun.',
'1 action',
'Vocal, Contact',
'Aucun',
'“Ce corps ne sera pas souillé !”',
'Une protection accrue de moitié face aux Maladies et aux différents Poisons.
Une fois son rôle accompli, la protection disparaît.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Aux quatre vents',
'Céleste',
'Mixte',
'21 m (14 cases)',
'1 Action',
'Aucune',
'Aucun.',
'Instantané',
'Vocal',
'Aucun',
'“Dispersez-vous !”',
'La créature invoque des vents tellement violents qu’ils repoussent sur 9 m tous
les ennemis ciblés.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Bouclier sacré',
'Divin',
'Combat',
'Personnelle',
'Tant que le bouclier est actif',
'Aucune',
'Aucun.',
'1 action',
'Vocal, Contact',
'Aucun',
'“Ô bien aimé, soit préservé”',
'La créature invoque un bouclier sacré qui enveloppe une cible et absorbe les
dégâts à sa place.
Le bouclier peut encaisser un nombre de dégâts égal au résultat de 2d6.
Une fois ce seuil atteint, le bouclier se dissipe.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Boule de feu',
'Igné',
'Combat',
'9 m (6 cases)',
'1 action',
'Aucune',
'Aucun.',
'Instantané',
'Vocal',
'Aucun',
'“Aux cendres !”',
'La créature incante une boule de feu qui vient brûler vif une créature, provoquant
3d4 de dégâts Ignés, et pouvant enflammer la créature sur une réussite critique.
- Au niveau 5, les dégâts passent à 3d6.
- Au niveau 10, les dégâts passent à 3d8.
- Au niveau 15, les dégâts passent à 3d10.
- Au niveau 20, les dégâts passent à 3d12.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Bénédiction solennelle',
'Divin',
'Mixte',
'Personnelle',
'1 action',
'Aucune',
'Aucun.',
'1 action',
'Vocal, Contact',
'Aucun',
'“Ne craint pas et relève toi mon enfant.”',
'La créature purge ou atténue grandement les effets de toutes malédictions sur une
cible en la bénissant. Si la malédiction est trop puissante pour être levée ainsi, la créature
reçoit des indices sur comment l’arrêter.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Brume spontanée',
'Aquatique',
'Mixte',
'Rayon de 9 m',
'1d4 tour(s) ou 5 mn',
'Aucune',
'Aucun.',
'1 action',
'Vocal, Ingrédient',
'- Flasque d’eau',
'“Brume, lève toi !”',
'La créature récite une formule, d’une flasque d’eau sort une brume épaisse qui
brouille complètement la vision des personnes se trouvant à l’intérieur.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Berceau d’illusion',
'Corrompu',
'Mixte',
'Personnelle',
'2 tours/5 mn',
'Aucune',
'Aucun.',
'1 action',
'Vocal',
'Aucun',
'“Que tes yeux te trompent et t’égarent !”',
'La créature enveloppe une cible d’un berceau d’illusions, altérant totalement sa
perception de la réalité.
La cible perçoit alors des visions façonnées par la volonté de l’incantateur :
- un environnement différent (forêt, flammes, gouffre, palais, etc.) ;
- des apparitions troublantes (danse de sorcières, silhouettes menaçantes, murmures) ;
- ou des menaces illusoires (démons attaquant, murs qui se referment, sol instable).
Les illusions n’infligent pas de dégâts réels, mais peuvent désorienter, effrayer ou détourner
l’attention de la cible pendant la durée de l’effet.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Bulles piégées',
'Aquatique',
'Mixte',
'Rayon de 9 m',
'Tant que la bulle existe, ou que
l''incantateur n’a pas annulé le sort',
'6 bulles maximum',
'Aucun.',
'1 action',
'Vocal, Ingrédient',
'- 1 Savon par bulle',
'“Bulles, ne laissez personne vous approcher
!”',
'La créature place des bulles sur un terrain, si quelqu’un s’approche dans la portée
de ces dernières, elles explosent, provoquant 2d8 de dégâts Aquatique au malheureux.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Carapace tellurique',
'Terrestre',
'Combat',
'Personnelle',
'1d4 tour(s)',
'Aucune',
'Aucun.',
'1 action',
'Vocal',
'Aucun',
'“Roche, protège ma peau !”',
'La créature concentre l’énergie terrestre, cette dernière l’entoure et forme une
carapace qui permet d’encaisser 4 dégâts supplémentaires, peu importe le type.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
