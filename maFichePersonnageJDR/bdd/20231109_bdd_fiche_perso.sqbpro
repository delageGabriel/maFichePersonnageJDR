INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Transformation d’armes',
'Divin',
'Mixte',
'Cible',
'Permanente',
'1/j',
'Aucun.',
'1 action',
'Vocal, Contact',
'Aucun',
'“Arme, deviens [nouvelle arme]”',
'La créature pose ses mains sur une arme et prononce une formule divine.
L’arme se transforme définitivement en une autre arme choisie par l’incantateur (par
exemple : une épée devient une lance, une lance devient une hache).
La nouvelle arme conserve le même métal, la même taille et le même niveau de qualité
que l’arme d’origine.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Transformation de l’état de la matière',
'Divin',
'Mixte',
'Cible',
'1 h',
'1/j',
'Aucun.',
'1 action',
'Vocal, Contact',
'Aucun',
'“Que ta structure change !”',
'La créature pose ses mains sur une cible et en altère l’état de la matière.
Selon sa volonté, elle peut modifier cet état de la manière suivante :
- un élément solide peut devenir mou ou liquide (un arbre devient flasque, une arme se
ramollit) ;
- un élément liquide peut devenir solide ou gazeux ;
- un élément gazeux peut être condensé sous une autre forme.
La cible conserve sa forme générale, mais ses propriétés physiques sont modifiées pendant
toute la durée de l’effet.'
);
