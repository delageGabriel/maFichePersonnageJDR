-- 4) Poids par qualité
INSERT OR REPLACE INTO MATERIAUX_POIDS (id_materiau, qualite, poids)
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       q, p
FROM (SELECT -2 q, 0.8 p UNION ALL SELECT -1, 0.8 UNION ALL SELECT 0, 1.5 UNION ALL SELECT 1, 1.5 UNION ALL SELECT 2, 3.2 UNION ALL SELECT 3, 3.2);

-- 5) Valeur par qualité
INSERT OR REPLACE INTO MATERIAUX_VALEUR (id_materiau, qualite, valeur)
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       q, v
FROM (SELECT -2 q, 14 v UNION ALL SELECT -1, 20 UNION ALL SELECT 0, 30 UNION ALL SELECT 1, 45 UNION ALL SELECT 2, 67 UNION ALL SELECT 3, 100);

