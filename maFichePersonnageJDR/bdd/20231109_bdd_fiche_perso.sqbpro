<display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- =========================
-- TISSU — nouveau schéma (compat MAX)
-- =========================

-- 0) Effets (sécurisés avec OR IGNORE) — répétés ici pour robustesse
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('tranchant','Tranchant','physique','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('contondant','Contondant','physique','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('perforant','Perforant','physique','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('ignee','Ignée / Feu','element','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('aquatique','Aquatique','element','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('celeste','Céleste (vent/foudre)','element','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('terrestre','Terrestre','element','pct');

INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('poisons','Poison','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('paralysie','Paralysie','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('maledictions','Malédictions','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('saignement','Saignement','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('choc','Choc','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('maladies','Maladies','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('acide','Acide','element','pct');

INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('chute','Chute','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('pression','Pression','etat','pct');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('chaleur','Chaleur (°C)','element','flat');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('froid','Froid (°C)','element','flat');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('initiative','Bonus d’initiative','bonus','flat');
INSERT OR IGNORE INTO REF_EFFETS(code,libelle,categorie,unite) VALUES ('vitesse','Vitesse de déplacement (m)','bonus','flat');

