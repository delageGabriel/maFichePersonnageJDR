'“Terre, élève moi !”',
'La créature pose ses mains au sol, un pilier de terre va alors émerger et la
surélever en hauteur, avant de nouveau s’abaisser.
Combustion spontanée'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
