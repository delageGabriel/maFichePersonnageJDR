-- Saignement
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='saignement'), q, v
FROM (SELECT -2 q, -1 v UNION ALL SELECT -1, -2 UNION ALL SELECT 0, -3 UNION ALL SELECT 1, -4 UNION ALL SELECT 2, -5 UNION ALL SELECT 3, -8);

-- Choc
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='choc'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, -1 UNION ALL SELECT 0, -2 UNION ALL SELECT 1, -3 UNION ALL SELECT 2, -5 UNION ALL SELECT 3, -7);

-- Maladies
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='maladies'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, -1 UNION ALL SELECT 1, -1 UNION ALL SELECT 2, -2 UNION ALL SELECT 3, -2);

-- Acide
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='acide'), q, v
FROM (SELECT -2 q, 2 v UNION ALL SELECT -1, 2 UNION ALL SELECT 0, 1 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, -1);

-- ===== Conditions / Températures / Initiative / Vitesse =====

-- Chute (%)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='chute'), q, v
FROM (SELECT -2 q, 1 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, -1 UNION ALL SELECT 2, -2 UNION ALL SELECT 3, -3);

-- Pression (%)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='pression'), q, v
FROM (SELECT -2 q, 2 v UNION ALL SELECT -1, 1 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, -1 UNION ALL SELECT 3, -2);

-- Chaleur (°C)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='chaleur'), q, v
FROM (SELECT -2 q, 20 v UNION ALL SELECT -1, 22 UNION ALL SELECT 0, 23 UNION ALL SELECT 1, 25 UNION ALL SELECT 2, 27 UNION ALL SELECT 3, 30);

-- Froid (°C)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='froid'), q, v
FROM (SELECT -2 q, 19 v UNION ALL SELECT -1, 17 UNION ALL SELECT 0, 15 UNION ALL SELECT 1, 12 UNION ALL SELECT 2, 7 UNION ALL SELECT 3, 0);

-- Initiative (bonus plat)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='initiative'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, 0);

-- Vitesse de déplacement (m)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='vitesse'), q, v
FROM (SELECT -2 q, 2 v UNION ALL SELECT -1, 1 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, 0);

