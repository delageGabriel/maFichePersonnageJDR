INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Ordre imposé',
'Neutre',
'Mixte',
'Cible',
'1 ordre',
'Aucune',
'Volonté',
'1 action',
'Vocal, Contact',
'Aucun',
'“Voulez-vous bien, je vous prie, faire
[ordre]”',
'La créature établit un contact physique avec une cible capable de la comprendre
et la regarde droit dans les yeux, lui adressant un ordre simple et direct.
La cible effectue un jet de Volonté. En cas d’échec, elle est contrainte d’exécuter l’ordre
donné, sans avoir conscience d’être sous une influence extérieure.
L’ordre doit être court, clair et réalisable immédiatement, et ne peut en aucun cas
pousser la cible à mettre en danger son intégrité physique ou aller frontalement contre ses
convictions profondes.
L’effet prend fin une fois l’ordre exécuté ou rendu impossible.'
);
