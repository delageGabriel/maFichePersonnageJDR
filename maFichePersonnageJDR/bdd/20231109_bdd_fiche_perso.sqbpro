INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Main cadavérique',
'Corrompu',
'Mixte',
'405 m (270 cases)',
'Cible intacte ou dans la portée.',
'Une seule main à la fois Jet de sauvegarde : Aucun.',
'',
'5 mn',
'Vocal, Ingrédients',
'Main d’un cadavre',
'“Sers-moi, et fait [ordre]”',
'La créature insuffle la vie dans la main d’un cadavre (squelettique ou
décomposé) ; avec une mission bien précise en tête. Cette dernière va faire tout ce qui est
en son possible pour accomplir l’objectif, et ce même s’il lui paraît impossible ou absurde.
NB : si elle est trop éloignée de l’incantateur, elle redevient inerte.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
