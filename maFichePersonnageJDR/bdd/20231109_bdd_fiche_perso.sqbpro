'Contact, Ingrédients',
'Feuilles d’arbres',
'“Arrêtez-nous !”',
'La créature consume une poignée de feuilles d’arbre pour créer une colonne de
vent tellement puissante, qu’elle peut élever sur une dizaine de mètres toutes personnes
entrant à l’intérieur.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
