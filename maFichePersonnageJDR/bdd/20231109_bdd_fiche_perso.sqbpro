       (SELECT id_effet FROM REF_EFFETS WHERE code='choc'), q, v
FROM (SELECT -2 q,4 v UNION ALL SELECT -1,3 UNION ALL SELECT 0,2 UNION ALL SELECT 1,1 UNION ALL SELECT 2,1 UNION ALL SELECT 3,0);

