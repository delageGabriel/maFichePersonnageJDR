'Vocal',
'Aucun',
'“Venez à moi, bons animaux !”',
'La créature entonne un chant harmonieux qui attire les animaux herbivores
alentour.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
 temps_incantation, composantes, ingredients, intentions_magiques, effets)
VALUES
(
'Colonne d’air',
'Céleste',
'Mixte',
'15 m (hauteur)',
'5 min',
'Aucune',
