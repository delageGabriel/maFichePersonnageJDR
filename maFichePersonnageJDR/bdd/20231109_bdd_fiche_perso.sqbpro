'Mixte',
'15 m (10 c)',
'1d4+2 tours',
'Aucune',
'Aucun.',
'Instantané',
'Vocal, Contact',
'Aucun',
'“Flammes, levez-vous !”',
'La créature pose ses mains au sol, et apparaissent en ligne devant elle des
colonnes de feu, qui s’étendent jusqu’à la limite de la portée du sort.
Quiconque est touché par ses colonnes prend les dégâts du sort Boule de feu.'
);
INSERT OR IGNORE INTO sorts
(nom, domaine, type, portee, duree, limite_usage, jet_sauvegarde,
