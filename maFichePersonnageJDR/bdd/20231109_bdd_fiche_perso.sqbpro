-- ===== BONUS / MALUS =====

-- Poisons
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='poisons'), q, v
FROM (SELECT -2 q,-2 v UNION ALL SELECT -1,-2 UNION ALL SELECT 0,-3 UNION ALL SELECT 1,-4 UNION ALL SELECT 2,-6 UNION ALL SELECT 3,-9);

-- Paralysie
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='paralysie'), q, v
FROM (SELECT -2 q,-2 v UNION ALL SELECT -1,-2 UNION ALL SELECT 0,-3 UNION ALL SELECT 1,-4 UNION ALL SELECT 2,-5 UNION ALL SELECT 3,-7);

-- Malédictions
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='maledictions'), q, v
FROM (SELECT -2 q,-3 v UNION ALL SELECT -1,-4 UNION ALL SELECT 0,-6 UNION ALL SELECT 1,-9 UNION ALL SELECT 2,-13 UNION ALL SELECT 3,-19);

-- Saignement
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='saignement'), q, v
FROM (SELECT -2 q,3 v UNION ALL SELECT -1,2 UNION ALL SELECT 0,2 UNION ALL SELECT 1,1 UNION ALL SELECT 2,1 UNION ALL SELECT 3,0);

-- Choc
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='choc'), q, v
FROM (SELECT -2 q,4 v UNION ALL SELECT -1,3 UNION ALL SELECT 0,2 UNION ALL SELECT 1,1 UNION ALL SELECT 2,1 UNION ALL SELECT 3,0);

-- Maladies
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='maladies'), q, v
FROM (SELECT -2 q,-2 v UNION ALL SELECT -1,-2 UNION ALL SELECT 0,-3 UNION ALL SELECT 1,-4 UNION ALL SELECT 2,-5 UNION ALL SELECT 3,-7);

-- Acide
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='acide'), q, v
FROM (SELECT -2 q,-4 v UNION ALL SELECT -1,-6 UNION ALL SELECT 0,-8 UNION ALL SELECT 1,-12 UNION ALL SELECT 2,-17 UNION ALL SELECT 3,-25);

-- ===== Conditions / Initiative / Vitesse =====
-- (Pas d’entrées Chaleur/Froid : “/” dans le tableau source)

-- Chute (%)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='chute'), q, v
FROM (SELECT -2 q,2 v UNION ALL SELECT -1,1 UNION ALL SELECT 0,1 UNION ALL SELECT 1,0 UNION ALL SELECT 2,-1 UNION ALL SELECT 3,-1);

-- Pression (%)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='pression'), q, v
FROM (SELECT -2 q,-3 v UNION ALL SELECT -1,-4 UNION ALL SELECT 0,-6 UNION ALL SELECT 1,-8 UNION ALL SELECT 2,-11 UNION ALL SELECT 3,-16);

-- Initiative
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='initiative'), q, v
FROM (SELECT -2 q,0 v UNION ALL SELECT -1,0 UNION ALL SELECT 0,0 UNION ALL SELECT 1,0 UNION ALL SELECT 2,0 UNION ALL SELECT 3,0);

-- Vitesse de déplacement (m)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='vitesse'), q, v
FROM (SELECT -2 q,0 v UNION ALL SELECT -1,0 UNION ALL SELECT 0,0 UNION ALL SELECT 1,0 UNION ALL SELECT 2,0 UNION ALL SELECT 3,0);

-- 4) Poids par qualité
INSERT OR REPLACE INTO MATERIAUX_POIDS (id_materiau, qualite, poids)
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       q, p
FROM (SELECT -2 q,3.5 p UNION ALL SELECT -1,3.5 UNION ALL SELECT 0,3.5 UNION ALL SELECT 1,3.5 UNION ALL SELECT 2,3.5 UNION ALL SELECT 3,3.5);

-- 5) Valeur par qualité
INSERT OR REPLACE INTO MATERIAUX_VALEUR (id_materiau, qualite, valeur)
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Diamant'),
       q, v
FROM (SELECT -2 q,127 v UNION ALL SELECT -1,190 UNION ALL SELECT 0,285 UNION ALL SELECT 1,427 UNION ALL SELECT 2,640 UNION ALL SELECT 3,960);</sql><current_tab id="0"/></tab_sql></sqlb_project>
