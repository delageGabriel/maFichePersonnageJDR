-- 1) Matériau
INSERT OR IGNORE INTO MATERIAUX (nom_materiau, categorie, realisme, description)
VALUES ('Tissu', 'Textile', 'reel', 'Matériau souple et léger : faible contre le tranchant, quelques atouts thermiques, mobilité correcte.');

-- 2) Coût &amp; rareté (base = valeur à Q0)
INSERT OR IGNORE INTO MATERIAUX_COUTS (id_materiau, base_valeur, rarete)
SELECT id_materiau, 30, 1
FROM MATERIAUX
WHERE nom_materiau='Tissu';

-- 3) Effets dégâts (par qualité q ∈ {-2,-1,0,1,2,3})

-- Tranchant
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='tranchant'), q, v
FROM (SELECT -2 q, 1 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, -1 UNION ALL SELECT 1, -2 UNION ALL SELECT 2, -3 UNION ALL SELECT 3, -5);

-- Contondant
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='contondant'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, 0);

-- Perforant
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='perforant'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, 0);

-- Ignée (Feu)
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='ignee'), q, v
FROM (SELECT -2 q,15 v UNION ALL SELECT -1,10 UNION ALL SELECT 0,7 UNION ALL SELECT 1,4 UNION ALL SELECT 2,3 UNION ALL SELECT 3,2);

-- Aquatique
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='aquatique'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, 0);

-- Céleste
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='celeste'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, 0 UNION ALL SELECT 3, 0);

-- Terrestre
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='terrestre'), q, v
FROM (SELECT -2 q, 3 v UNION ALL SELECT -1, 2 UNION ALL SELECT 0, 1 UNION ALL SELECT 1, 0 UNION ALL SELECT 2, -1 UNION ALL SELECT 3, -2);

-- ===== BONUS / MALUS =====

-- Poisons
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='poisons'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, -1 UNION ALL SELECT 2, -1 UNION ALL SELECT 3, -2);

-- Paralysie
INSERT OR REPLACE INTO MATERIAUX_EFFETS
SELECT (SELECT id_materiau FROM MATERIAUX WHERE nom_materiau='Tissu'),
       (SELECT id_effet FROM REF_EFFETS WHERE code='paralysie'), q, v
FROM (SELECT -2 q, 0 v UNION ALL SELECT -1, 0 UNION ALL SELECT 0, 0 UNION ALL SELECT 1, -1 UNION ALL SELECT 2, -1 UNION ALL SELECT 3, -2);

