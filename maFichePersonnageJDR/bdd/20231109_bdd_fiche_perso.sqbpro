'“Dresse-toi dans le sens opposé !”',
'La créature se trouve dans un courant d’eau, à son contact et en récitant une
formule magique, elle inverse le courant de cette dernière pendant une durée courte.'
);
INSERT OR IGNORE INTO sorts
