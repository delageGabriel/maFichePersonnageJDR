tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE NEW_ARMES (
    id_arme INTEGER PRIMARY KEY,
    nom_arme TEXT NOT NULL,
    type_arme TEXT NOT NULL,
    pre_requis_utilisation_arme TEXT,
    mains_arme TEXT,
